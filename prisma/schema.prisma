generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id           String   @id @default(cuid())
  razonSocial  String
  rfc          String
  calle        String
  numero       String
  colonia      String
  codigoPostal String
  ciudad       String
  estado       String
  telefono     String
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  presupuestos Presupuesto[]

  @@index([razonSocial])
  @@index([rfc])
}

model Unidad {
  id        String     @id @default(cuid())
  unidad    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  productos Producto[]
}

model Categoria {
  id        String     @id @default(cuid())
  categoria String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  productos Producto[]
}

model Iva {
  id        String     @id @default(cuid())
  tasa      Float      @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  productos Producto[]
}

model Producto {
  id          String    @id @default(cuid())
  codigoSat   String
  descripcion String
  unidadId    String
  unidad      Unidad    @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  ivaId       String
  iva         Iva       @relation(fields: [ivaId], references: [id], onDelete: Restrict)
  costo       Float
  margen      Float
  subtotal    Float
  notas       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  presupuestoItems PresupuestoItem[]

  @@index([descripcion])
  @@index([codigoSat])
}

model Presupuesto {
  id            String            @id @default(cuid())
  clienteId     String
  cliente       Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fecha         String
  observaciones String?
  subtotal      Float
  iva           Float
  total         Float
  items         PresupuestoItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([clienteId])
  @@index([fecha])
}

model PresupuestoItem {
  id             String      @id @default(cuid())
  presupuestoId  String
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  productoId     String?
  producto       Producto?   @relation(fields: [productoId], references: [id], onDelete: SetNull)
  descripcion    String
  codigoSat      String?
  unidad         String?
  cantidad       Float
  precioUnitario Float
  importe        Float
  ivaTasa        Float
  ivaImporte     Float
  orden          Int

  @@index([presupuestoId])
}

model Configuracion {
  id               String   @id @default("principal")
  nombreComercial  String
  razonLegal       String
  rfc              String
  direccion        String
  telefono         String
  email            String
  logo             String?
  smtpHost         String   @default("")
  smtpPuerto       Int      @default(587)
  smtpCifrado      String   @default("SSL")
  smtpUsuario      String   @default("")
  smtpPassword     String   @default("")
  presupuestoColor String   @default("#1D4ED8")
  presupuestoFila  String   @default("normal")
  presupuestoLogo  String?
  reciboColor      String   @default("#1D4ED8")
  reciboFila       String   @default("grande")
  reciboLogo       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
