generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id           String   @id @default(cuid())
  razonSocial  String
  rfc          String
  calle        String
  numero       String
  colonia      String
  codigoPostal String
  ciudad       String
  estado       String
  telefono     String
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([razonSocial])
  @@index([rfc])
}

model Unidad {
  id        String   @id @default(cuid())
  unidad    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id        String   @id @default(cuid())
  categoria String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Iva {
  id        String   @id @default(cuid())
  tasa      Float    @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Configuracion {
  id               String   @id @default("principal")
  nombreComercial  String
  razonLegal       String
  rfc              String
  direccion        String
  telefono         String
  email            String
  logo             String?
  smtpHost         String   @default("")
  smtpPuerto       Int      @default(587)
  smtpCifrado      String   @default("SSL")
  smtpUsuario      String   @default("")
  smtpPassword     String   @default("")
  presupuestoColor String   @default("#1D4ED8")
  presupuestoFila  String   @default("normal")
  presupuestoLogo  String?
  reciboColor      String   @default("#1D4ED8")
  reciboFila       String   @default("grande")
  reciboLogo       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
